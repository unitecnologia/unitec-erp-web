<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="OsFiscalLock">
            <file>tests/Feature/OsFiscalLockTest.php</file>
        </testsuite>
        <testsuite name="OsFaturamentoFechamento">
            <file>tests/Feature/OsFaturamentoFechamentoTest.php</file>
        </testsuite>
        <testsuite name="OsFaturamentoConcorrencia">
            <file>tests/Feature/OsFaturamentoConcorrenciaDevTest.php</file>
        </testsuite>
        <testsuite name="OsDescontoFechamentoRateio">
            <file>tests/Unit/OsDescontoFechamentoRateioTest.php</file>
        </testsuite>
        <testsuite name="OsNfcePecasEmissao">
            <file>tests/Feature/OsNfcePecasEmissaoTest.php</file>
        </testsuite>
        <testsuite name="OsNfcePecasWiring">
            <file>tests/Unit/OsNfcePecasWiringTest.php</file>
        </testsuite>
        <testsuite name="NfceOrdemServicoConferirPecas">
            <file>tests/Unit/NfceOrdemServicoConferirPecasTest.php</file>
        </testsuite>
        <testsuite name="Os108NfceConferenciaDev">
            <file>tests/Feature/Os108NfceConferenciaDevTest.php</file>
        </testsuite>
        <testsuite name="NfeOrdemServicoOperacaoFiscal">
            <file>tests/Unit/NfeOrdemServicoOperacaoFiscalTest.php</file>
        </testsuite>
        <testsuite name="NfeOrdemServicoOperacaoFiscalDev">
            <file>tests/Feature/NfeOrdemServicoOperacaoFiscalDevTest.php</file>
        </testsuite>
        <testsuite name="OrcamentoDuplicacao">
            <file>tests/Feature/OrcamentoDuplicacaoTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- MySQL DEV (base de bkp). Credenciais vêm do .env; só força o destino. -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-no-config.php" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="unitec_erp" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="ERP_OS_FIN_PERF" value="1"/>
    </php>
</phpunit>
