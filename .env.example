APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Cloudflare Tunnel / acesso remoto ao Gestor (/gestor):
# APP_URL=https://gestor.seudominio.com.br
# SESSION_SECURE_COOKIE=true
# Veja docs/GESTOR-CLOUDFLARE-TUNNEL.md

# Zoom da interface no Chrome/Edge (50-200). Ex.: 90=menor, 100=normal, 110=maior
UNITEC_BROWSER_ZOOM=100

# Licenca remota (gerenciador Unitec / Replit)
# GET {UNITEC_LICENCA_API_URL}/api/licenca/{cnpj}
UNITEC_LICENCA_API_URL=https://unitecnologiasc.digital
UNITEC_LICENCA_API_ENABLED=true
UNITEC_LICENCA_API_TIMEOUT=8
UNITEC_LICENCA_API_CACHE_SECONDS=120
UNITEC_LICENCA_API_GRACE_HOURS=24
# Link do pagamento/QR no portal
UNITEC_LICENCA_PAGAMENTO_URL=https://unitecnologiasc.digital

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unitec_erp
DB_USERNAME=root
DB_PASSWORD=rua@2050bc
DB_PREFIX=unitec_

# Firebird legado (migra???�???�o erp:migra-firebird)
FB_ENABLED=true
FB_HOST=localhost
FB_PORT=3050
FB_DATABASE=C:/Sistema/Dados/dados.fdb
FB_USERNAME=SYSDBA
FB_PASSWORD=
FB_CHARSET=WIN1252
FB_USE_EMBEDDED=false
# FB_ISQL="C:/Program Files (x86)/Firebird/Firebird_3_0/isql.exe"

# Backup MySQL (opcional; se vazio, usa tools/mysql/bin/mysqldump ou PATH)
# MYSQLDUMP_PATH=C:/Projetos/unitec-erp-web/tools/mysql/bin/mysqldump.exe

# DEV_RUNTIME=windows  (ajuste automatico: .\scripts\use-env-windows.ps1)

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Com Cloudflare Tunnel (HTTPS p?blico), ative:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IBPT ? De Olho no Imposto (https://deolhonoimposto.ibpt.org.br)
# Token adquirido no portal; pode ser sobrescrito por empresa (Imposto Padr?????�o ? IPBTAX).
IBPT_BASE_URL=https://apidoni.ibpt.org.br/api/v1
IBPT_TOKEN=
IBPT_TIMEOUT=30

# Link HTTPS direto ao Unitec-ERP-Update.zip (GitHub Releases - canal estavel).
# Pode trocar no .env do cliente a qualquer hora sem republicar.
UNITEC_UPDATE_DOWNLOAD_URL=https://github.com/unitecnologia/unitec-erp-web/releases/download/update/Unitec-ERP-Update.zip

# Mercado Pago ? recebimento Pix din?????�mico (For?????�a de Vendas)
# Access token de PRODU?????�?????�O da conta. A confirma?????�?????�o ?????� por polling (o servidor
# consulta a API do MP); o webhook ?????� opcional e s?????� funciona com URL p?????�blica.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=

# Mercado Livre — integração de pedidos (OAuth + webhook)
# Preferência: preencher na aba Empresa → Parâmetros → Mercado Livre.
# Hub Unitec (clientes sem site):
MELI_HUB_URL=https://unitecnologiasc.com.br
MELI_HUB_REDIRECT_URI=https://unitecnologiasc.com.br/meli/hub/oauth/callback
MELI_IS_HUB=true
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

# Unitecnologia Device Service (agente local no PC do caixa)
UNITEC_DEVICE_SERVICE_URL=http://127.0.0.1:9330
UNITEC_DEVICE_SERVICE_KEY=
UNITEC_DEVICE_SERVICE_TIMEOUT_MS=2500

# QZ Tray ? legado (opcional; Device Service substitui)
# QZ_CERTIFICATE_PATH=
# QZ_PRIVATE_KEY_PATH=


# Web Push  Painel Executivo (/gestor). Em produηγo use HTTPS e gere novas chaves.
VAPID_SUBJECT=mailto:suporte@unitecnologia.com.br
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
