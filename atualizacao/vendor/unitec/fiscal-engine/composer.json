{
    "name": "unitec/fiscal-engine",
    "description": "Motor fiscal Unitec — montagem, assinatura e transmissão de documentos eletrônicos (NFC-e MVP SC).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "robrichards/xmlseclibs": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Unitec\\FiscalEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unitec\\FiscalEngine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
