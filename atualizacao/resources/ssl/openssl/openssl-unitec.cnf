# Unitec ERP — OpenSSL 3 com provider legacy (certificados A1 .pfx antigos / RC2-40).
# Usado por PHP ao ler PKCS#12 (openssl_pkcs12_read).

openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1
